      },
      "TreeNode": {
        "properties": {
          "capacity_kva": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Transformer capacity in kVA (if type is DT).",
            "title": "Capacity Kva"
          },
          "children": {
            "description": "Child nodes in the network topology.",
            "items": {
              "$ref": "#/components/schemas/TreeNode"
            },
            "title": "Children",
            "type": "array"
          },
          "id": {
            "description": "Unique code or ID for the topology node.",
            "title": "Id",
            "type": "string"
          },
          "meter_count": {
            "default": 0,
            "description": "Total meters connected under this subtree.",
            "minimum": 0.0,
            "title": "Meter Count",
            "type": "integer"
          },
          "name": {
            "description": "Descriptive human-readable label.",
            "title": "Name",
            "type": "string"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Identifier of parent node.",
            "title": "Parent Id"
          },
          "type": {
            "$ref": "#/components/schemas/NodeType",
            "description": "Hierarchical tier type."
          }
        },
        "required": [
          "id",
          "name",
          "type"
        ],
        "title": "TreeNode",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Production-grade RESTful API service providing clean, documented, and resilient access to the legacy Urja Meter Ops smart-metering portal.",
    "title": "Urja Meter Ops API Service",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "Reports the live operational health of the API service, reachability and latency of the upstream Urja portal, and local database cache freshness.",
        "operationId": "check_health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Service health and upstream reachability check",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/hierarchy": {
      "get": {
        "description": "Returns the full 7-tier distribution network hierarchy (Zone -> Circle -> Division -> Subdivision -> Substation -> Feeder -> DT) with meter count rollups at every node.",
        "operationId": "get_network_tree_api_v1_hierarchy_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NetworkHierarchyResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get complete distribution network tree",
        "tags": [
          "Hierarchy"
        ]
      }
    },
    "/api/v1/hierarchy/nodes/{node_id}": {
      "get": {
        "description": "Inspect a specific node in the network hierarchy (e.g. DT or Feeder) with its full ancestor path from the root Zone down to parent, immediate children, and meter count.",
        "operationId": "get_node_detail_api_v1_hierarchy_nodes__node_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "node_id",
            "required": true,
            "schema": {
              "title": "Node Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeDetailView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get hierarchy node detail view",
        "tags": [
          "Hierarchy"
        ]
      }
    },
    "/api/v1/meters": {
      "get": {
        "description": "Retrieve a paginated collection of smart meters with optional filtering, sorting, and geospatial radius search.",
        "operationId": "list_meters_api_v1_meters_get",
        "parameters": [
          {
            "description": "Search substring against meterId or serialNo (e.g. J1000 or SE33).",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search substring against meterId or serialNo (e.g. J1000 or SE33).",
              "title": "Q"
            }
          },
          {
            "description": "Filter by manufacturer (e.g. HPL, Genus, Secure, L&T, Allied).",
            "in": "query",
            "name": "make",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by manufacturer (e.g. HPL, Genus, Secure, L&T, Allied).",
              "title": "Make"
            }
          },
          {
            "description": "Filter by status (Installed, Faulty, Decommissioned).",
            "in": "query",
            "name": "install_status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by status (Installed, Faulty, Decommissioned).",
              "title": "Install Status"
            }
          },
          {
            "description": "Filter by phase (single, three).",
            "in": "query",
            "name": "phase_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by phase (single, three).",
              "title": "Phase Type"
            }
          },
          {
            "description": "Filter by Distribution Transformer code (e.g. DT-001).",
            "in": "query",
            "name": "dt_code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by Distribution Transformer code (e.g. DT-001).",
              "title": "Dt Code"
            }
          },
          {
            "description": "Filter by 11kV Feeder code (e.g. F-001).",
            "in": "query",
            "name": "feeder_code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by 11kV Feeder code (e.g. F-001).",
              "title": "Feeder Code"
            }
          },
          {
            "description": "Latitude for spatial radius query (WGS 84).",
            "in": "query",
            "name": "near_lat",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 90.0,
                  "minimum": -90.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Latitude for spatial radius query (WGS 84).",
              "title": "Near Lat"
            }
          },
          {
            "description": "Longitude for spatial radius query (WGS 84).",
            "in": "query",
            "name": "near_lng",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 180.0,
                  "minimum": -180.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Longitude for spatial radius query (WGS 84).",
              "title": "Near Lng"
            }
          },
          {
            "description": "Search radius in kilometers around (near_lat, near_lng).",
            "in": "query",
            "name": "radius_km",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0.0,
                  "maximum": 500.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search radius in kilometers around (near_lat, near_lng).",
              "title": "Radius Km"
            }
          },
          {
            "description": "Sort attribute: meter_id, serial_number, make, install_status, phase_type.",
            "in": "query",
            "name": "sort_by",
            "required": false,
            "schema": {
              "default": "meter_id",
              "description": "Sort attribute: meter_id, serial_number, make, install_status, phase_type.",
              "title": "Sort By",
              "type": "string"
            }
          },
          {
            "description": "Sort order: asc or desc.",
            "in": "query",
            "name": "sort_order",
            "required": false,
            "schema": {
              "default": "asc",
              "description": "Sort order: asc or desc.",
              "pattern": "^(asc|desc)$",
              "title": "Sort Order",
              "type": "string"
            }
          },
          {
            "description": "Page index (1-based).",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "Page index (1-based).",
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "Number of records per page (max 200).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "description": "Number of records per page (max 200).",
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResponse_MeterSummary_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List and filter smart meters",
        "tags": [
          "Meters"
        ]
      }
    },
    "/api/v1/meters/{meter_id}": {
      "get": {
        "description": "Look up full meter specifications, nameplate attributes, coordinates, and network hierarchy by meter ID.",
        "operationId": "get_meter_api_v1_meters__meter_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "meter_id",
            "required": true,
            "schema": {
              "title": "Meter Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get single meter detail",
        "tags": [
          "Meters"
        ]
      }
    },
    "/api/v1/meters/{meter_id}/consumption": {
      "get": {
        "description": "Retrieve half-hourly interval load survey readings, cumulative registers (kWh, kVAh), voltage, and calculated window consumption.",
        "operationId": "get_meter_consumption_api_v1_meters__meter_id__consumption_get",
        "parameters": [
          {
            "in": "path",
            "name": "meter_id",
            "required": true,
            "schema": {
              "title": "Meter Id",
              "type": "string"
            }
          },
          {
            "description": "Start date/timestamp boundary (e.g. 2026-06-25 or 2026-06-25T00:00:00).",
            "in": "query",
            "name": "from_date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start date/timestamp boundary (e.g. 2026-06-25 or 2026-06-25T00:00:00).",
              "title": "From Date"
            }
          },
          {
            "description": "End date/timestamp boundary (e.g. 2026-06-28).",
            "in": "query",
            "name": "to_date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "End date/timestamp boundary (e.g. 2026-06-28).",
              "title": "To Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterConsumptionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get meter energy telemetry",
        "tags": [
          "Consumption"
        ]
      }
    },
    "/api/v1/sync": {
      "post": {
        "description": "Synchronizes the complete dataset (all meters and distribution transformers) from the Urja portal into the local SQLite index. Rate limited by cooldown.",
        "operationId": "trigger_sync_api_v1_sync_post",
        "parameters": [
          {
            "description": "Bypass the cooldown period (use with caution).",
            "in": "query",
            "name": "force",
            "required": false,
            "schema": {
              "default": false,
              "description": "Bypass the cooldown period (use with caution).",
              "title": "Force",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Trigger bulk synchronization from portal",
        "tags": [
          "Synchronization"
        ]
      }
    },
    "/api/v1/sync/status": {
      "get": {
        "description": "Returns the status of the local SQLite index, record count, and timestamp of the last successful synchronization.",
        "operationId": "get_sync_status_api_v1_sync_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check dataset synchronization status",
        "tags": [
          "Synchronization"
        ]
      }
    }
  }
}