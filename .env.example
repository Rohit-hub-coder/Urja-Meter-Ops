# Urja Meter Ops Portal Configuration
URJA_PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
URJA_PORTAL_USERNAME=your_username_here
URJA_PORTAL_PASSWORD=your_password_here

# Service Configuration
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
ENVIRONMENT=development

# Upstream Client Constraints (Polite Client)
PORTAL_MAX_CONCURRENCY=2
PORTAL_REQUEST_DELAY_SEC=0.3
PORTAL_TIMEOUT_SEC=15.0
PORTAL_USER_AGENT=UrjaMeterOpsApi/1.0 (take-home candidate; https://github.com/candidate/urja-api)

# Database
DATABASE_URL=sqlite+aiosqlite:///urja_local.db

# Live Smoke Testing (Set to true only when explicitly executing live smoke test)
ENABLE_LIVE_PORTAL_TESTS=false
